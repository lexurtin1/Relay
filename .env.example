# Product
# Display name shown in the header and docs. Default: Relay
APP_NAME=Relay

# mock (default) uses seeded connectors and scripted LLM responses when no gateway key is set.
# live expects real connector credentials and a gateway key.
RELAY_MODE=mock

# All model calls go through the SS&C AI Gateway (Anthropic-compatible Messages API).
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=

# Single model id for research, planning, building, review, and summaries.
MODEL_ID=claude-opus-5-5

# Postgres (docker compose default shown)
DATABASE_URL=postgresql://relay:relay@localhost:5432/relay?schema=public

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# Job guardrails
TOKEN_BUDGET_PER_JOB=200000
JOB_TIMEOUT_MS=1800000

# Live connector stubs (Milestone 2+). Leave blank in mock mode.
SALESFORCE_INSTANCE_URL=
JIRA_BASE_URL=
CONFLUENCE_BASE_URL=
POWERBI_WORKSPACE_ID=
DATABRICKS_HOST=
GITHUB_TOKEN=
