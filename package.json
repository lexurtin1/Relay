{
  "name": "relay",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "next dev --port 3000",
    "dev:web": "next dev --port 3000",
    "dev:worker": "pnpm --filter @relay/worker dev",
    "dev:all": "pnpm --parallel --filter relay --filter @relay/worker dev",
    "build": "next build",
    "build:packages": "pnpm -r --filter @relay/core --filter @relay/connectors --filter @relay/agents --filter @relay/worker build",
    "start": "next start --port 3000",
    "lint": "next lint",
    "test": "pnpm -r --if-present test && vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@relay/agents": "workspace:*",
    "@relay/connectors": "workspace:*",
    "@relay/core": "workspace:*",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "geist": "^1.9.2",
    "lucide-react": "^1.73.0",
    "next": "^15.2.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.14",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "prisma": "^6.5.0",
    "tailwindcss": "^4.0.14",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
